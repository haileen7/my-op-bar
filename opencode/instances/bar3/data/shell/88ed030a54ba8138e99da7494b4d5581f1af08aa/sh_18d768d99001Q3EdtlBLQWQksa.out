app/Http/Controllers/Api/TicketController.php:60:                'attachments',
--- api routes tickets ---
122:    // Ticket API routes — reads: ability:tickets:read (Issue #690)
125:    // nested middleware is AND. `getApiTokenAbilities()` grants `tickets:read`
126:    // only from `view_assigned_tickets|view_all_tickets`, so the `user` role —
127:    // which holds `create_ticket` alone — minted a token that could satisfy
128:    // `abilities:tickets:write` and never `ability:tickets:read`, and every
130:    // worked on the web UI (`routes/web.php` gates `tickets/new` on
131:    // `create_ticket` alone). The writes have their own group below.
136:    Route::middleware('ability:tickets:read')->group(function () {
137:        Route::get('/tickets', [TicketController::class, 'index'])
138:            ->middleware('role_or_permission:view_assigned_tickets|view_all_tickets');
139:        Route::get('/tickets/{ticket}', [TicketController::class, 'show'])
140:            ->middleware('role_or_permission:view_assigned_tickets|view_all_tickets');
143:    // Ticket API writes — abilities:tickets:write, no read ability required
145:    Route::middleware('abilities:tickets:write')->group(function () {
146:        Route::post('/tickets', [TicketController::class, 'store'])
147:            ->middleware('permission:create_ticket');
148:        Route::put('/tickets/{ticket}', [TicketController::class, 'update'])
149:            ->middleware('permission:manage_unit_tickets');
150:        Route::delete('/tickets/{ticket}', [TicketController::class, 'destroy'])
151:            ->middleware('permission:manage_unit_tickets');
